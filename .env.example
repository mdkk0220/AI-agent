# 이 파일을 .env 로 복사해서 값을 채우세요. (.env 는 git 에 올라가지 않습니다)
# 키를 이 파일(.env.example)에 직접 적지 마세요.
ROCKETPUNCH_APP_KEY=rp_app_여기에_발급받은_키

# LLM 초안 작성 (선택). DRAFTER=llm 으로 두면 Gemini 로 초안을 쓰고, 키가 없거나 실패하면 템플릿 초안으로 대신합니다.
DRAFTER=llm
GEMINI_API_KEY=여기에_발급받은_키
# GEMINI_MODEL=gemini-3.5-flash-lite   # 404 가 나오면 쓸 수 있는 모델 이름으로 바꾸세요
