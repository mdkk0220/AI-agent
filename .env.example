# 이 파일을 .env 로 복사해서 값을 채우세요. .env 는 절대 커밋하지 않습니다 (.gitignore 처리됨).

# 로켓펀치 App Key (개발자 콘솔에서 앱 등록 후 확인. rp_app_ 로 시작. rp_sec_ 로 시작하는 Secret key 가 아님)
ROCKETPUNCH_APP_KEY=

# 사람인 Open API access-key (승인 후 [Application] > [내 앱리스트] > 앱 이름에서 확인). 승인 전이면 비워 둠
SARAMIN_ACCESS_KEY=

# 3단계(LLM 분류)부터 사용. 비워 두면 MOCK 모드(규칙 분류기 결과 재사용)로 동작합니다.
# 형식: "제공사:모델명". 모델명은 제공사 문서에서 현재 사용 가능한 이름을 확인해서 넣으세요.
# 제공사별 키 환경변수 이름은 해당 langchain 연동 패키지 문서를 따르세요.
LLM_MODEL=

# 1로 두면 LLM 키가 있어도 강제로 MOCK 모드
MOCK=
